# Copy to .env and adjust. .env is git-ignored; never commit real secrets.

# Where the master profile, versions, and role profiles are stored (default: ./data)
RESUME_OPTIMIZER_DATA_DIR=
# Where generated resumes will be written (default: ./output)
RESUME_OPTIMIZER_OUTPUT_DIR=
# DEBUG, INFO, WARNING, ERROR. Logs never include profile content.
RESUME_OPTIMIZER_LOG_LEVEL=INFO

# Best-effort job-page import by URL (on/off). Paste and file upload always work.
# Fetches honour robots.txt and never bypass sign-in or bot checks.
RESUME_OPTIMIZER_URL_IMPORT=on
# Per-request timeout in seconds for URL import (clamped to 1-30)
RESUME_OPTIMIZER_URL_TIMEOUT=10

# LLM providers are NOT used yet (planned for Milestone 5). When added, keys
# will be read only from the environment, e.g.:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
