# Copy to .env and adjust. .env is git-ignored; never commit real secrets.
# Most options can also be set on the Settings page. A non-empty value here
# overrides the Settings page, so leave a line blank to manage it in the app.

# Where the master profile, versions, and role profiles are stored (default: ./data)
RESUME_OPTIMIZER_DATA_DIR=
# Where generated resumes will be written (default: ./output)
RESUME_OPTIMIZER_OUTPUT_DIR=
# DEBUG, INFO, WARNING, ERROR. Logs never include profile content.
RESUME_OPTIMIZER_LOG_LEVEL=INFO

# Best-effort job-page import by URL (on/off). Paste and file upload always work.
# Fetches honour robots.txt and never bypass sign-in or bot checks.
RESUME_OPTIMIZER_URL_IMPORT=
# Per-request timeout in seconds for URL import (clamped to 1-30)
RESUME_OPTIMIZER_URL_TIMEOUT=

# Optional AI rewriting of resume wording (off by default). When enabled, the
# selected bullets, role titles and JD requirement terms are sent to the provider
# ONLY after you tick the consent box on Resume Builder. Contact details are never sent.
# none | anthropic | openai
RESUME_OPTIMIZER_LLM_PROVIDER=
# Model ID. Anthropic defaults to claude-opus-5-5; OpenAI has no default, so set one.
RESUME_OPTIMIZER_LLM_MODEL=
# Request timeout in seconds (5-600)
RESUME_OPTIMIZER_LLM_TIMEOUT=
# API keys are read by the provider SDKs from the environment. Never commit them.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Resume export page size: A4 (default) or Letter
RESUME_OPTIMIZER_PAGE_SIZE=
# Resume template: classic (default) or compact
RESUME_OPTIMIZER_TEMPLATE=
# on = never contact any external service (disables URL import and AI rewriting)
RESUME_OPTIMIZER_LOCAL_ONLY=
# Optional TrueType fonts embedded in exported PDFs. By default the app looks for
# Arial / DejaVu Sans / Liberation Sans and falls back to built-in Helvetica.
# RESUME_OPTIMIZER_PDF_FONT=
# RESUME_OPTIMIZER_PDF_FONT_BOLD=

# Optional browser extension: local receiver (python -m src.extension_receiver)
# on = accept captures from the extension; off by default. Port 1024-65535 (default 8765).
RESUME_OPTIMIZER_EXTENSION=
RESUME_OPTIMIZER_EXTENSION_PORT=
